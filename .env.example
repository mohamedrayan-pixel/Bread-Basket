# Everything here is optional. Copy to .env only if you need it.
PORT=3001
# Public https address of your site (e.g. your domain or tunnel URL, no trailing slash).
# Used for the bill and "Payment Screenshot" links inside the WhatsApp message so they open on your phone.
# PUBLIC_BASE_URL=https://orders.your-domain.com
# Max payment-screenshot size in MB
MAX_UPLOAD_MB=5
# Max new orders per visitor (IP address) per hour
ORDER_RATE_LIMIT=20
# Set to 1 only if the site runs behind nginx / a hosting load balancer
# TRUST_PROXY=1
